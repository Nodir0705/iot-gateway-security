# Copy to ../gateway.env and fill in for your environment, then:  source gateway.env
# (gateway.env is git-ignored — it holds your secrets and site-specific values.)

# ── Network ───────────────────────────────────────────────────────────────
export MONITOR_IFACE=eth0          # interface the pipeline + Suricata capture on
export GATEWAY_IP=192.168.13.1     # this device's LAN address
export TARGET_IP=192.168.13.48     # IoT device under test (attack-sim target)

# ── NPU / Python ──────────────────────────────────────────────────────────
export PYTHONPATH=$HOME/.local/lib/python3.10/site-packages

# ── InfluxDB (optional — only for metrics_exporter.py) ────────────────────
export INFLUX_TOKEN=               # REQUIRED if using metrics export; paste your token
# INFLUX_URL/ORG/BUCKET are set in scripts/metrics_exporter.py (localhost:8086 / iotgw / security)

# ── Suricata eve.json location (must match suricata-iot.yaml) ─────────────
export EVE_LOG=$HOME/iot-gateway/logs/eve.json
